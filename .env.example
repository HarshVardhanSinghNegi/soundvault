# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: fill these in once your Google AdSense account is approved.
# Leave blank to see dashed "Ad space" placeholders instead of real ads.
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_LEFT=XXXXXXXXXX
VITE_ADSENSE_SLOT_RIGHT=XXXXXXXXXX
VITE_ADSENSE_SLOT_BOTTOM=XXXXXXXXXX
